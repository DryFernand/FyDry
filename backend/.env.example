# ==========================================
# FYDRY BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==========================================

# Application Settings
PROJECT_NAME="FyDry API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_URL="http://localhost:3000"

# ==========================================
# SECURITY & JWT CONFIGURATION
# ==========================================
JWT_SECRET_KEY="tu_clave_secreta_jwt"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=5
OTP_EXPIRE_MINUTES=10

# ==========================================
# SUPABASE DATABASE CONFIGURATION (POSTGRESQL)
# ==========================================
DATABASE_URL="postgresql+psycopg2://postgres:TU_DATABASE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
DATABASE_POOLER_URL="postgresql+psycopg2://postgres.PROJECT_REF:TU_DATABASE_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# ==========================================
# SUPABASE API CREDENTIALS
# ==========================================
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="tu_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="tu_supabase_service_role_key"
SUPABASE_JWT_SECRET="tu_supabase_jwt_secret"

# ==========================================
# GOOGLE SMTP CONFIGURATION (CORREOS / OTP)
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu_correo@gmail.com"
SMTP_PASSWORD="tu_google_app_password"
EMAILS_FROM_EMAIL="tu_correo@gmail.com"
EMAILS_FROM_NAME="FyDry Seguridad"
SMTP_TLS=True

# ==========================================
# OAUTH PROVIDERS (GOOGLE & GITHUB)
# ==========================================
GOOGLE_CLIENT_ID="tu_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu_google_client_secret"

GITHUB_CLIENT_ID="tu_github_client_id"
GITHUB_CLIENT_SECRET="tu_github_client_secret"
