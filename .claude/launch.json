{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3010,
      "autoPort": true
    },
    {
      "name": "frontend-local-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3010,
      "autoPort": false,
      "env": { "NEXT_PUBLIC_API_URL": "http://localhost:8010/api/v1" }
    }
  ]
}
